# Copy this file to .env on the server, then replace every change-me value.

COMPOSE_PROJECT_NAME=muhou

MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_DATABASE=muhou
MYSQL_USER=muhou
MYSQL_PASSWORD=change-me-app-password

SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8078
JAVA_OPTS=-Xms256m -Xmx768m

MUHOU_AUTH_TOKEN_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
MUHOU_AUTH_DEMO_LOGIN_ENABLED=false

WECHAT_MOCK_ENABLED=false
WECHAT_MINIAPP_APP_ID=wxaf7914ed6be3ebdb
WECHAT_MINIAPP_APP_SECRET=change-me
WECHAT_QR_ENV_VERSION=trial

# Keep payment mock enabled until the official merchant configuration is ready.
WECHAT_PAY_MOCK_ENABLED=true
WECHAT_PAY_MCH_ID=
WECHAT_PAY_PRIVATE_KEY_PATH=
WECHAT_PAY_MERCHANT_SERIAL_NO=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_NOTIFY_URL=https://api.example.com/api/pay/wechat/notify
WECHAT_PAY_REFUND_NOTIFY_URL=https://api.example.com/api/pay/wechat/refund-notify
